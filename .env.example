# Copy to .env. Never commit .env.
# Every value here is a LOCAL DEVELOPMENT default. Settings refuses to boot in
# prod with any of them still in place -- see app/core/config.py.

APP_ENV=local                 # local | dev | prod
LOG_LEVEL=INFO
API_PORT=8001

# ── Database ───────────────────────────────────────────────────────────────
# There is no local Postgres. This points at the Aurora Serverless v2 cluster
# that ../platform provisions. Get the value with:
#
#   terraform -chdir=../platform/infra output -raw database_url_auth
#
# The cluster pauses when idle, so the first connection after a break takes
# ~15 seconds to resume. That is expected, not a fault.
DATABASE_URL=postgresql+asyncpg://teachassist:CHANGE_ME@CHANGE_ME.psql-lms-dev-801755.postgres.database.azure.com:5432/authdb
TEST_DATABASE_URL=postgresql+asyncpg://teachassist:CHANGE_ME@CHANGE_ME.psql-lms-dev-801755.postgres.database.azure.com:5432/authdb_test

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_ECHO=false

# The cluster endpoint is public, so `require` (encrypt only) is not enough --
# it does not authenticate the server. verify-full checks the chain against the
# RDS CA bundle; download it once to the path below:
#   curl -o rds-ca.pem https://truststore.pki.psql-lms-dev-801755.postgres.database.azure.com/global/global-bundle.pem
DB_SSL_MODE=verify-full        # disable | require | verify-full
DB_CA_BUNDLE_PATH=rds-ca.pem

# ── Token issuance ─────────────────────────────────────────────────────────
# ISSUER must match byte-for-byte what consumers verify against, and must
# differ per environment so a dev token can never be accepted in prod.
ISSUER=http://localhost:8001
AUDIENCE=teachassist-api
ACCESS_TOKEN_TTL_SECONDS=600           # 10 minutes
REFRESH_IDLE_TTL_SECONDS=43200         # 12 hours
REFRESH_ABSOLUTE_TTL_SECONDS=604800    # 7 days
REFRESH_GRACE_SECONDS=10               # two-tabs-refreshing window
CLOCK_SKEW_LEEWAY_SECONDS=60

# ── Signing ────────────────────────────────────────────────────────────────
SIGNER_BACKEND=local          # local | azure_key_vault
KEY_VAULT_KEY_ID=
# base64 of 32 random bytes; required by the local signer outside APP_ENV=local.
# Generate with:  python -c "from app.crypto.keywrap import generate_kek; print(generate_kek())"
LOCAL_KEY_ENCRYPTION_KEY=
JWKS_CACHE_TTL_SECONDS=300
# A new key must sit in JWKS at least this long before it may sign anything.
KEY_MIN_PUBLISH_DELAY_SECONDS=600

# ── Passwords ──────────────────────────────────────────────────────────────
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST_KIB=65536           # 64 MiB
ARGON2_PARALLELISM=1
ARGON2_MAX_CONCURRENCY=8               # bounds 64MiB x N; see password_service
PASSWORD_MIN_LENGTH=12
PASSWORD_MAX_BYTES=1024                # a 10MB password is a free Argon2 DoS

# ── Lockout and throttling ─────────────────────────────────────────────────
LOCKOUT_THRESHOLD=5
LOCKOUT_MAX_MINUTES=30
IP_THROTTLE_MAX_FAILURES=20
IP_THROTTLE_WINDOW_SECONDS=900

# ── Cookies ────────────────────────────────────────────────────────────────
# Secure=false is only tolerable on http://localhost. Prod refuses it.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
REFRESH_COOKIE_NAME=__Host-ta_rt
CSRF_COOKIE_NAME=__Host-ta_csrf

# ── CORS ───────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000

# ── Local seeding ──────────────────────────────────────────────────────────
# Well-known so .env.example can carry it. Settings REFUSES to boot with this
# set when APP_ENV is not "local".
DEV_SEED_PASSWORD=devpassword123
DEV_SEED_TENANT_SLUG=springfield-high
